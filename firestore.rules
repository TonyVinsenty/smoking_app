rules_version = '2';

// Zero: friends, leaderboard and chats. Paste into Firebase console → Firestore → Rules → Publish.
// Who sees what:
// - a profile (users/{uid}) is visible to its owner and to people in the owner's friends list;
// - a friends list is visible only to its owner;
// - codes/{code} can be read only by someone who already knows the code (no listing);
// - a photo (avatars/{uid}) is visible like the profile: to its owner and to the owner's friends;
// - a chat, its messages and read markers are visible only to its members; chat images are size-limited;
//   only friends start chats and add people;
// - everyone writes only their own data; the one exception is adding yourself to someone's friends list,
//   allowed only together with that person's friend code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNick(v) {
      return v is string && v.size() > 0 && v.size() <= 40;
    }

    function optInt(d, key) {
      return !(key in d) || (d[key] is int && d[key] >= 0 && d[key] < 100000000);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['nick', 'code', 'xp', 'badges', 'days', 'money', 'updatedAt'])
        && isNick(d.nick)
        && d.code is string && d.code.size() == 8
        && optInt(d, 'xp') && optInt(d, 'badges') && optInt(d, 'days') && optInt(d, 'money');
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;

      match /friends/{fid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && fid != uid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code is string
          && (request.auth.uid == uid
              || (request.auth.uid == fid
                  && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
      }
    }

    // A small JPEG as base64: at most 160 000 characters (≈120 KB).
    match /avatars/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img', 'at'])
        && request.resource.data.img is string
        && request.resource.data.img.size() <= 160000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Chats: one-to-one (id = both uids sorted, joined by "_") and groups of up to 5.
    // Only members read and write; a chat is started and people are added only by their friends;
    // in a one-to-one chat one can write only while still friends.
    function isFriend(u) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(u));
    }

    function friendOrMe(list, i) {
      return list.size() <= i || list[i] == request.auth.uid || isFriend(list[i]);
    }

    function allFriends(list) {
      return friendOrMe(list, 0) && friendOrMe(list, 1) && friendOrMe(list, 2)
        && friendOrMe(list, 3) && friendOrMe(list, 4);
    }

    function validChat(d) {
      return d.keys().hasOnly(['members', 'group', 'title', 'names', 'last', 'updatedAt'])
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 5
        && d.group is bool
        && (!('title' in d) || (d.title is string && d.title.size() <= 40))
        && d.names is map
        && d.last is map && d.last.keys().hasOnly(['from', 'text', 'at', 'sys'])
        && d.last.from == request.auth.uid
        && d.last.text is string && d.last.text.size() <= 1000
        && d.updatedAt == request.time;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn() && validChat(request.resource.data)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && allFriends(request.resource.data.members)
        && (request.resource.data.group
            ? request.resource.data.members.size() >= 2
            : request.resource.data.members.size() == 2
              && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && validChat(request.resource.data)
        && request.resource.data.group == resource.data.group
        && (resource.data.group || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']))
        // members: the same; or a group gets the writer's friends added; or the writer leaves
        && (request.resource.data.members == resource.data.members
            || (resource.data.group
                && request.resource.data.members.hasAll(resource.data.members)
                && allFriends(request.resource.data.members.removeAll(resource.data.members)))
            || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
        // names: only one's own and of the people one adds
        && request.resource.data.names.diff(resource.data.names).affectedKeys()
          .hasOnly(request.resource.data.members.removeAll(resource.data.members).concat([request.auth.uid]));
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];

      match /messages/{mid} {
        function chatBefore() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if signedIn() && request.auth.uid in chatBefore().members;
        // Written together with the chat itself: the chat may be created or left in the same batch.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'sys', 'image'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (!('image' in request.resource.data)
              || (request.resource.data.image is string && request.resource.data.image.size() <= 300000))
          && (request.resource.data.text.size() > 0 || 'image' in request.resource.data)
          && (('sys' in request.resource.data)
              ? request.resource.data.sys in ['created', 'added', 'left', 'renamed'] && !('image' in request.resource.data)
              : (request.resource.data.text.size() > 0 || 'image' in request.resource.data))
          && (request.auth.uid in chatBefore().members || request.auth.uid in chatAfter().members)
          // events only in groups; in a one-to-one chat only while still friends
          && (chatAfter().group
              || (!('sys' in request.resource.data)
                  && isFriend(chatAfter().members.removeAll([request.auth.uid])[0])));
        allow delete: if signedIn()
          && (resource.data.from == request.auth.uid || chatBefore().members == [request.auth.uid]);
      }

      match /reads/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'nick'])
        && request.resource.data.uid == request.auth.uid
        && isNick(request.resource.data.nick);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nick'])
        && request.resource.data.uid == resource.data.uid
        && isNick(request.resource.data.nick);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
